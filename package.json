{
  "name": "shamela-reader",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host",
    "typecheck": "tsc -b --noEmit",
    "verify": "vite build --ssr scripts/verify-parsers.ts --outDir .verify --logLevel warn && node .verify/verify-parsers.js",
    "glossary": "vite build --ssr scripts/build-glossary.ts --outDir .verify --logLevel warn && node .verify/build-glossary.js",
    "catalog": "vite build --ssr scripts/build-catalog.ts --outDir .verify --logLevel warn && node .verify/build-catalog.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.120.0",
    "@huggingface/transformers": "^4.2.0",
    "@tanstack/react-virtual": "^3.13.12",
    "idb": "^8.0.3",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "sql.js": "^1.14.2",
    "vite-plugin-pwa": "^1.3.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.13",
    "@types/jsdom": "^30.0.0",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@types/sql.js": "^1.4.11",
    "@vitejs/plugin-react": "^5.0.2",
    "jsdom": "^30.0.1",
    "tailwindcss": "^4.1.13",
    "typescript": "^5.9.2",
    "vite": "^7.1.5"
  }
}
