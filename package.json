{
  "name": "shamela-reader",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host",
    "stage": "node scripts/stage.mjs",
    "share:add": "node scripts/share-add.mjs",
    "typecheck": "tsc -b --noEmit",
    "layers": "node scripts/check-layers.mjs",
    "verify": "vite build --ssr scripts/verify-parsers.ts --outDir .verify --logLevel warn && node .verify/verify-parsers.js",
    "report:hadith-json": "vite build --ssr scripts/report-hadith-json.ts --outDir .verify/hadith --logLevel warn && node .verify/hadith/report-hadith-json.js",
    "measure:hadith-corpus": "vite build --ssr scripts/measure-hadith-corpus.ts --outDir .verify/corpus --logLevel warn && node .verify/corpus/measure-hadith-corpus.js",
    "verify:selection": "vite build --logLevel warn && node scripts/verify-selection.mjs",
    "verify:reader": "vite build --logLevel warn && node scripts/verify-reader-scroll.mjs",
    "verify:markup": "node scripts/verify-markup.mjs",
    "verify:storage": "vite build --logLevel warn && node scripts/verify-storage.mjs",
    "verify:translate": "vite build --logLevel warn && node scripts/verify-translate.mjs",
    "verify:requests": "vite build --ssr scripts/verify-requests.ts --outDir .verify/requests --logLevel warn && node .verify/requests/verify-requests.js",
    "glossary": "vite build --ssr scripts/build-glossary.ts --outDir .verify --logLevel warn && node .verify/build-glossary.js",
    "catalog": "vite build --ssr scripts/build-catalog.ts --outDir .verify --logLevel warn && node .verify/build-catalog.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.120.0",
    "@huggingface/transformers": "^4.2.0",
    "@tanstack/react-virtual": "^3.13.12",
    "idb": "^8.0.3",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "sql.js": "^1.14.2",
    "vite-plugin-pwa": "^1.3.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.13",
    "@types/jsdom": "^30.0.0",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@types/sql.js": "^1.4.11",
    "@vitejs/plugin-react": "^5.0.2",
    "jsdom": "^30.0.1",
    "playwright": "1.63.0",
    "tailwindcss": "^4.1.13",
    "typescript": "^5.9.2",
    "vite": "^7.1.5"
  }
}
