# Leading slashes are load-bearing here. A pattern with a separator only at the
# END — `qul/` — has no separator at its beginning or middle, so git matches it
# at ANY level: it ignores the data folder at the root AND `src/qul/`, the five
# source modules behind the QUL feature. That happened, and it surfaced as
# sixteen unrelated-looking TS2307/TS7006 errors in CI rather than as "your
# source is missing". Anchor anything that names a top-level directory.

node_modules/
/dist/
/.verify/
# wrangler's local state and build cache. Anchored, per the note above.
/proxy/.wrangler/
*.local
.DS_Store

# --- Never commit -----------------------------------------------------------
# API keys live in this browser's localStorage and are deliberately absent from
# AppSettings, so no export and no file here has ever carried one. These
# patterns exist so that stays true by accident as well as by design.
.env
.env.*
*.pem
*.key

# --- Book and third-party data ----------------------------------------------
# This repository is public, and none of the following is needed to build or
# run the app.
#
# /fixtures/  real fetched pages from shamela.ws, kept so the parsers can be
#             verified against markup rather than against a guess. Copyrighted
#             book text.
# /qul/       resources downloaded from the Qurʾān Universal Library, under
#             their own licence terms. NOT src/qul/, which is source code.
#
# `npm run verify` reads both and so only runs where they are present, which is
# a local checkout. The deploy workflow runs `npm run build`.
/fixtures/
/qul/

# --- Bundled QUL resources: per resource, not per folder ----------------------
# The licences differ per resource, so "QUL" is not one answer — and excluding
# the whole folder answered it as though it were, which kept a redistributable
# file out of the deployed build along with the two that had to stay out.
#
# The `*` and the negation are both load-bearing, and this is the one gitignore
# idiom that does not read the way it looks:
#
#     /public/qul/    excludes the DIRECTORY, and git will then not re-include
#                     anything inside it. A following `!` line does nothing.
#     /public/qul/*   excludes the CONTENTS, leaving the directory itself
#                     un-excluded — which is what makes `!` work below.
#
# Default to excluded. A resource is added to the negation list only after its
# terms have been read, and the reason is recorded beside it in src/qul/seed.ts
# so the judgement travels with the decision. See docs/RESOURCES.md.
/public/qul/*

# Computed matching data — ayah keys, word counts, coverage percentages, word
# offsets — produced by QUL's own pass over the muṣḥaf. No third party's writing
# to redistribute, so it ships, and seeding treats a 404 on it as a bug.
!/public/qul/matching-ayah.json

# Deliberately still excluded, both modern and in copyright:
#   ar-tafsir-muyassar.json  King Fahd Complex, 2000s
#   surah-info-en.json       Mawdūdī's Tafhīm al-Qurʾān sūrah introductions

# --- Personal work ----------------------------------------------------------
# The glossary is authored terminology, not source. Delete these two lines if
# you would rather version it.
/glossary-sources/
/glossary-import.json
